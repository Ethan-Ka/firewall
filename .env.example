# firewall environment configuration
#
# Copy to .env and fill in. .env is git-ignored; .env.example is not, so keep
# real credentials out of this file.
#
#   cp .env.example .env
#
# Precedence, lowest to highest:
#   DEFAULTS in firewall/config.py  <  config.json  <  .env  <  real environment
#
# Everything here is optional. Mock mode needs none of it.

# ---------------------------------------------------------------- broadcastify
# Required for --source broadcastify. Register at bcfy.io/dev/apply.
# Billing is prepaid and metered, charged per record read, $5 minimum credit.
# The key needs the bcfy_calls_api entitlement.
#
# MEASURED RATE, portal usage page 2026-08-19: 1,032 records = $0.62, so
# ~$0.0006 per record read. A $5 credit is about 8,300 records. What that buys:
#
#   one init=1 fetch (25 records)   $0.015   <- the unit that actually costs
#   one poll with no new calls      $0.000   <- polling itself is free
#   steady state, whole system      ~$0.01/hour (~16 records/hour here)
#   stuck in init=1 at 5s polls     $10.80/hour -- burns $5 in 28 minutes
#
# The cost driver is records per fetch, NOT fetches per hour. Lowering
# FIREWALL_POLL_SECONDS below is not a saving; keeping the pos cursor advancing
# (so polls stay empty and free) is the whole game.
#
# Auth is NOT the raw key as a bearer token. It is a short-lived HS256 JWT
# signed with the key, carrying the API Key ID as "kid" and the Application ID
# as "iss". All three values are required. See firewall/bcfy_auth.py.
BCFY_API_KEY=
# portal -> API Keys
BCFY_KEY_ID=
# portal -> Company & Apps
BCFY_APP_ID=

# Live Calls requires an authenticated Broadcastify user inside the JWT, except
# for public playlists. A free account is enough; premium only adds archives.
BCFY_USERNAME=
BCFY_PASSWORD=

# Host only. Endpoint paths are /{endpoint}/v1, e.g. /calls/v1/live/.
BCFY_API_BASE=https://api.bcfy.io

# The trunked system id. Confirmed by the docs to be the RadioReference sid:
# 9099 for Tippecanoe County Government. Not the Ingest API's systemId, which
# identifies uploader nodes.
BCFY_SYSTEM_ID=9099

# Talkgroups to watch, as decimal id:name pairs separated by commas.
# Max 5: they are sent as one comma-delimited {sid}-{talkgroup} `groups` query
# so filtering happens server-side and you are billed only for these
# departments. Past 5 it falls back to whole-system `sid` polling, which bills
# for every record in the county (~73% waste here). Default is West Lafayette.
BCFY_TALKGROUPS=2021:West Lafayette FD,2105:Purdue FD
# The rest of the county, if you want it -- and it is the bulk of the traffic:
#   1901:Lafayette FD,1827:Tippecanoe County Fire,1833:Tippecanoe EMS

# Seconds between polls. The API documents a 5s floor and it is enforced in
# code; each poll costs money, so do not lower this.
FIREWALL_POLL_SECONDS=5

# ----------------------------------------------------------------------- trunk
# Where trunk-recorder writes call WAVs and their .json sidecars.
FIREWALL_TRUNK_DIR=./trunk-out

# ---------------------------------------------------------------- transcription
# tiny.en | base.en | small.en
FIREWALL_WHISPER_MODEL=base.en

# Set true to send garbled transcripts to Claude instead of the regex parser.
# Falls back to regex automatically if the call fails. Needs ANTHROPIC_API_KEY
# and pip install -e ".[llm]". Roughly $0.0002 per call.
FIREWALL_USE_LLM_PARSER=false
ANTHROPIC_API_KEY=

# ------------------------------------------------------------------ eta / you
# Your location, so the display can say when a run passes your door rather than
# only when it reaches the scene. Leave blank and you still get the scene ETA.
#
# FORMAT -- any of these work, all verified against the live geocoders:
#
#   531 W Navajo St, West Lafayette, IN 47906   full address; ZIP is optional
#   531 W Navajo St, West Lafayette, IN         city and state
#   531 W Navajo St                             street alone; West Lafayette,
#                                                IN is assumed
#   Cary Quadrangle                              a landmark or building name
#   40.451520,-86.915309                         exact coords, no lookup at all
#
# Do not quote it, and do not add an apartment or unit number -- neither
# geocoder handles a unit and both do better without one. Abbreviations are
# fine either way: St / Street / St. and W / West all resolve identically.
#
# Anything with a comma is split into street, city and state, so naming a city
# means the lookup happens THERE. Get the city wrong and you get nothing back
# rather than a wrong answer: "500 W Navajo St, Lafayette, IN" returns no match,
# because that street is in West Lafayette. That matters more here than most
# places -- Lafayette and West Lafayette are different cities four miles and one
# river apart, and they share street names.
#
# Resolved once and cached in .geocache.json (git-ignored, like this file's real
# counterpart). Delete that file to force a re-lookup. Startup logs the
# coordinates it resolved to, so check them once against a map.
#
# Accuracy: about +/- a minute, and no method does better. The dominant term is
# turnout -- dispatch tones to wheels rolling -- which runs 60-90s and varies
# per call. Tune firewall/geo.py:TURNOUT_SECONDS against runs you watch.
FIREWALL_HOME=

# How close a run must come to count as "you would hear the siren". 600m covers
# the surrounding streets, not just your own.
FIREWALL_SIREN_METRES=600

# ---------------------------------------------------------------------- display
# How long a call stays on screen, in seconds.
FIREWALL_HOLD_SECONDS=600

# HTTP port for the display and /api/current.
FIREWALL_PORT=842
